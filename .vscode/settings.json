{
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "rust-analyzer.rustfmt.extraArgs": ["+nightly"],
  "rust-analyzer.checkOnSave": true,
  "files.associations": {
    "*.rs": "rust",
    "Cargo.toml": "toml",
    "rustfmt.toml": "toml",
    ".clippy.toml": "toml"
  }
}
